# Jarvis — environment template. Copy to .env and fill in. Never commit .env.

# — Database (async SQLAlchemy URL) —
# Dev: local Postgres. Tests override with sqlite+aiosqlite automatically.
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# — Envelope encryption master key (32 bytes, base64) —
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
JARVIS_MASTER_KEY=

# — Exchange —
EXCHANGE=binance
BINANCE_TESTNET=true

# — i18n —
DEFAULT_LOCALE=ko

# — Misc —
SQL_ECHO=false
